{
	"$schema": "node_modules/wrangler/config-schema.json",
	// ── ĐỔI KHI NHÂN BẢN CHO DỰ ÁN MỚI ──────────────────────────────
	"name": "qtopia-lead-worker",
	"vars": {
		// Tên dự án, ghi vào cột "project" trên Sheet
		"PROJECT_NAME": "QTOPIA",
		// Mã dự án trong CMS (Supabase) — lead hiện ở trang Lead của qtopia-cms
		"PROJECT_ID": "qtopia",
		// Supabase dùng chung của CMS (để trống = không đồng bộ sang CMS)
		"SUPABASE_URL": "https://ocbsfqgqukhaixskzwdz.supabase.co",
		// Origin được phép gửi lead (phân tách bằng dấu phẩy, KHÔNG có "/" cuối):
		//   qtopia.rever.io.vn = landing page · qtopia-cms = trang CMS
		//   ocbsfqgqukhaixskzwdz.supabase.co = Supabase CMS (Edge Function gửi lead thử)
		"ALLOWED_ORIGINS": "https://qtopia.rever.io.vn,https://qtopia-cms.vercel.app,https://ocbsfqgqukhaixskzwdz.supabase.co",
		// Cho phép http://localhost:* gửi thử khi dev ("false" khi đã chạy thật)
		"ALLOW_LOCALHOST": "false",
		// Số lần gửi tối đa mỗi phút cho mỗi IP
		"RATE_LIMIT_PER_MINUTE": "5"
	},
	// Secret (không nằm trong file này): npx wrangler secret put GOOGLE_SHEET_URL
	//                                    npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
	// ────────────────────────────────────────────────────────────────

	"main": "src/index.js",
	"compatibility_date": "2026-08-03",
	"observability": { "enabled": true },
	"upload_source_maps": true
}
