# Cấu hình riêng của domain qtopiaseaside.vn (ghi đè .env.production khi build site này).
# Bản build: <QTOPIA_BASE_DIR>/sites/qtopiaseaside.vn/current — nginx tự chọn thư mục theo tên domain.
VITE_SITE_URL=https://qtopiaseaside.vn

# Google Tag Manager — container riêng của domain này. GA4/Ads/Pixel cấu hình TRONG GTM.
VITE_GTM_ID=GTM-5HW5ZKMG
# GA4 gắn thẳng (gtag.js) — chỉ dùng khi KHÔNG có GTM, tránh đếm trùng. Để trống.
VITE_GA4_ID=
