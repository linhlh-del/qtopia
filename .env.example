# Sao chép thành .env.production khi phát hành. Biến VITE_* được nhúng vào bản build.

# Tên miền chính thức (KHÔNG có dấu / ở cuối) — dùng cho canonical, og:url, sitemap.xml, robots.txt, JSON-LD.
# Chưa đặt → build dùng domain mẫu và cảnh báo (STRICT_SEO=1 để build lỗi nếu quên).
VITE_SITE_URL=https://qtopia.rever.io.vn

# Google Tag Manager (GTM-XXXXXXX). Để trống = không nạp GTM (sự kiện vẫn đẩy vào window.dataLayer).
VITE_GTM_ID=

# Endpoint nhận lead (CRM / Google Sheet / Worker). Để trống = form báo lỗi "chế độ demo", KHÔNG giả lập gửi thành công.
VITE_LEAD_ENDPOINT=

# ---- CMS (Supabase dùng chung — cms-supabase/) ----
# Build lấy nội dung đã publish của project "qtopia". Anon key chỉ đọc được bản đã publish (RPC cms_get_published_content).
# Để trống = dùng nội dung mặc định trong code. Đã đặt mà Supabase lỗi → build dừng, website giữ bản đang chạy.
CMS_SUPABASE_URL=
CMS_SUPABASE_ANON_KEY=

# ---- Phát hành trên VPS (scripts/release.mjs) ----
# Thư mục chứa releases/ và symlink current (mặc định: thư mục cha của mã nguồn, vd /var/www/qtopia)
QTOPIA_BASE_DIR=
# Số bản build giữ lại để rollback
QTOPIA_KEEP=5
# 1 = git pull --ff-only trước khi build (khi phát hành cả code lẫn nội dung)
QTOPIA_GIT_PULL=0
